{
  "name": "domainkeeper",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext .ts,.tsx,.js,.jsx",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "supabase:deploy:notify": "supabase functions deploy notify-expiring-services --project-ref $SUPABASE_PROJECT_REF",
    "supabase:invoke:notify": "supabase functions invoke notify-expiring-services --project-ref $SUPABASE_PROJECT_REF --no-verify-jwt"
  },
  "dependencies": {
    "@google/genai": "^1.31.0",
    "@supabase/supabase-js": "^2.86.2",
    "react": "^19.2.1",
    "react-dom": "^19.2.1"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@typescript-eslint/eslint-plugin": "^8.48.1",
    "@typescript-eslint/parser": "^8.48.1",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "prettier": "^3.7.4",
    "supabase": "^2.65.6",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
